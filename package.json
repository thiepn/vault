{
  "name": "@thiepn/vault",
  "version": "0.22.0-phase22",
  "private": true,
  "type": "module",
  "description": "Vault — browser-first Markdown knowledge system",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "npm run build:core && node --test tests/phase1.test.mjs tests/phase2.test.mjs tests/phase3.test.mjs tests/phase4.test.mjs tests/phase5.test.mjs tests/phase6.test.mjs tests/phase7.test.mjs tests/phase8.test.mjs tests/phase9.test.mjs tests/phase10.test.mjs tests/phase11.test.mjs tests/phase12.test.mjs tests/phase13.test.mjs tests/phase14.test.mjs tests/phase15.test.mjs tests/phase16.test.mjs tests/phase17.test.mjs tests/phase18.test.mjs tests/phase19.test.mjs tests/phase20.test.mjs tests/phase21.test.mjs tests/phase22.test.mjs tests/a1-domain.test.mjs tests/a2-storage.test.mjs tests/i1-protocol-v2.test.mjs tests/i2-crypto.test.mjs tests/i3-keys.test.mjs tests/i4-remote-state.test.mjs tests/i5-encrypted-sync.test.mjs tests/i6-multidevice-conflicts.test.mjs tests/i7-encrypted-attachments.test.mjs tests/i8-fresh-bootstrap.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark:search": "npm run build:core && node scripts/benchmark-phase4.mjs",
    "benchmark:graph": "npm run build:core && node scripts/benchmark-phase10.mjs",
    "benchmark:board": "npm run build:core && node scripts/benchmark-phase11.mjs",
    "benchmark:canvas": "npm run build:core && node scripts/benchmark-phase12.mjs",
    "benchmark:interop": "npm run build:core && node scripts/benchmark-phase13.mjs",
    "benchmark:sync-foundation": "npm run build:core && node scripts/benchmark-phase14.mjs",
    "benchmark:replication": "npm run build:core && node scripts/benchmark-phase15.mjs",
    "benchmark:sync-hardening": "npm run build:core && node scripts/benchmark-phase16.mjs",
    "benchmark:realtime-wakeup": "npm run build:core && node scripts/benchmark-phase17.mjs",
    "benchmark:collaboration": "npm run build:core && node scripts/benchmark-phase19.mjs",
    "benchmark:crdt": "npm run build:core && node scripts/benchmark-phase20.mjs",
    "benchmark:conflicts": "npm run build:core && node scripts/benchmark-phase22.mjs",
    "benchmark:i4-remote-state": "npm run build:core && node scripts/benchmark-i4.mjs",
    "benchmark:i6-conflicts": "npm run build:core && node scripts/benchmark-i6.mjs",
    "benchmark:i7-blobs": "npm run build:core && node scripts/benchmark-i7.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "codemirror": "6.0.2",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "marked": "18.0.13",
    "marked-katex-extension": "5.1.13",
    "mermaid": "12.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@codemirror/autocomplete": "6.20.3",
    "yaml": "2.9.1",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.8.3",
    "vite": "8.1.0"
  }
}
