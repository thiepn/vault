{
  "name": "@thiepn/vault",
  "version": "0.9.0-phase9",
  "private": true,
  "type": "module",
  "description": "Vault — browser-first Markdown knowledge system",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "npm run build:core && node --test tests/phase1.test.mjs tests/phase2.test.mjs tests/phase3.test.mjs tests/phase4.test.mjs tests/phase5.test.mjs tests/phase6.test.mjs tests/phase7.test.mjs tests/phase8.test.mjs tests/phase9.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark:search": "npm run build:core && node scripts/benchmark-phase4.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "codemirror": "6.0.2",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "marked": "18.0.13",
    "marked-katex-extension": "5.1.13",
    "mermaid": "12.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@codemirror/autocomplete": "6.20.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.8.3",
    "vite": "8.1.0"
  }
}
