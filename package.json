{
  "name": "@thiepn/vault",
  "version": "0.1.0-phase1",
  "private": true,
  "type": "module",
  "description": "Vault — browser-first Markdown knowledge system",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "npm run build:core && node --test tests/phase1.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.8.3",
    "vite": "8.1.0"
  }
}
