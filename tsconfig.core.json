{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "build/core",
    "rootDir": "src"
  },
  "include": [
    "src/domain/**/*.ts",
    "src/crypto/**/*.ts",
    "src/storage/**/*.ts",
    "src/services/**/*.ts",
    "src/sync/**/*.ts",
    "src/cloud/**/*.ts",
    "src/commands/**/*.ts",
    "src/markdown/**/*.ts",
    "src/adapters/supabase-auth.ts",
    "src/knowledge/**/*.ts",
    "src/search/**/*.ts",
    "src/metadata/**/*.ts",
    "src/planning/**/*.ts",
    "src/tasks/**/*.ts",
    "src/queries/**/*.ts",
    "src/media/**/*.ts",
    "src/graph/**/*.ts",
    "src/boards/**/*.ts",
    "src/canvas/**/*.ts",
    "src/interoperability/**/*.ts",
    "src/app/workspace.ts",
    "src/editor/**/*.ts"
  ]
}
